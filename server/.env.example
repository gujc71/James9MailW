# ------------------------------------------------------------------ 웹서버
PORT=4000
HOST=127.0.0.1
# 세션 쿠키 서명 키. 운영에서는 반드시 바꾼다 (32바이트 이상)
# openssl rand -hex 32 로 만든 값. 운영(NODE_ENV=production)에서 예시 값이면 기동하지 않는다
SESSION_SECRET=change-me
SESSION_TTL_HOURS=12
# 개발 중 Vite dev 서버 origin. 비우면 same-origin 만 허용한다
CORS_ORIGIN=http://localhost:5173
# HTTPS 로 서비스하면 1 (쿠키 Secure + HSTS). NODE_ENV=production 이면 기본 1
COOKIE_SECURE=
# 앞단 프록시가 있을 때만: 1 또는 프록시 IP 목록(콤마). 비우면 X-Forwarded-* 를 믿지 않는다
TRUST_PROXY=
# 메일 본문 링크(대용량 첨부)의 기준 주소. 예: https://mail.example.com
PUBLIC_BASE_URL=
# 빌드한 클라이언트 폴더. 비우면 ../client/dist 를 찾아 정적 서빙한다
CLIENT_DIST_DIR=
# 로그인 실패 잠금: (IP, 계정) 조합의 허용 횟수와 잠금 분
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ------------------------------------------------------------------ MariaDB (james-database.properties 와 같은 DB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=james_db
# 조회 전용 풀 크기. James 배달 트랜잭션과 커넥션을 다투지 않도록 분리한다
DB_POOL_SIZE=10

# ------------------------------------------------------------------ 파일시스템 (웹서버와 James 가 같은 파일시스템을 본다: 1-6)
# James MailFileStorage.baseDir() 과 같은 값.
#   james.mail.store.dir 이 설정돼 있으면 그 값,
#   아니면 {working.directory}/var/store/maildir
MAIL_STORE_DIR=../../mailServer/var/store/maildir
# APPEND 스테이징 폴더. James 쪽 james.mail.staging.dir 과 같은 절대경로여야 한다 (4-1)
MAIL_STAGING_DIR=../../mailServer/var/store/staging
# 대용량 첨부 보관 루트 (GU_LARGE_ATTACH.FILE_PATH 의 기준)
LARGE_ATTACH_DIR=../../mailServer/var/store/large
# 업로드 임시 파일 (multipart 스트림을 메모리에 올리지 않는다: 3-5)
UPLOAD_TMP_DIR=../../mailServer/var/store/tmp

# ------------------------------------------------------------------ James
# 커스텀 라우트를 포함한 WebAdmin. 무인증이므로 반드시 localhost 로 묶어 둔다 (4-1a)
JAMES_WEBADMIN_URL=http://localhost:8000
JAMES_WEBADMIN_TIMEOUT_MS=30000
# SMTP 25. 587 은 비활성이고 25 는 authorizedAddresses=127.0.0.0/8 무인증 릴레이다 (1-2)
JAMES_SMTP_HOST=127.0.0.1
JAMES_SMTP_PORT=25

# ------------------------------------------------------------------ 정책
# 툼스톤 보관 일수. 이보다 오래된 커서는 410 으로 전체 재동기화시킨다
TOMBSTONE_KEEP_DAYS=30
# 외부메일 계정 비밀번호 암호화 키 (AES-256-GCM, 32바이트 hex 64자)
# openssl rand -hex 32. 한 번 정하면 바꾸지 않는다 (바꾸면 저장된 외부메일 비밀번호를 풀 수 없다)
SECRET_KEY=change-me
# 발송 메일의 Message-ID 도메인. 비우면 발신자 주소의 도메인을 쓴다
MESSAGE_ID_DOMAIN=
# 외부메일: 사내(사설 IP) 서버 허용 · 인증서 검증 끄기(자체 서명 인증서). 둘 다 꼭 필요할 때만 1
EXTERNAL_MAIL_ALLOW_PRIVATE=0
EXTERNAL_MAIL_TLS_INSECURE=0
