{
  "name": "james9mail-web-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "james9Mail webmail server - reads MariaDB directly, serves raw mail files, builds MIME and submits through James",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:codegen": "kysely-codegen --dialect mysql --out-file src/db/generated.d.ts",
    "backfill:thread": "tsx src/scripts/backfillThread.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "dompurify": "^3.2.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "imapflow": "^1.0.187",
    "jsdom": "^26.0.0",
    "kysely": "^0.27.5",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.10.0",
    "postal-mime": "^2.7.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^6.4.17",
    "kysely-codegen": "^0.17.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
